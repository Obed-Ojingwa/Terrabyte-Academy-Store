# Backend Environment Variables
# Copy this file to .env and adjust the values as needed

# App Settings
APP_NAME=Terrabyte Academy Store
APP_VERSION=1.0.0
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Security Settings
SECRET_KEY=your-super-secret-key-change-in-production
REFRESH_SECRET_KEY=your-super-secret-refresh-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Settings (if using Supabase Storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Email Settings (for notifications - for development, leave empty to use logging)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME=Terrabyte Academy Store

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://terrabiteacademystore.com"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
UPLOAD_DIRECTORY=/tmp/uploads

# Pagination Settings
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100